{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "objectWrap": "collapse",
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": false,
  "trailingComma": "none",
  "sortImports": true,
  "sortPackageJson": { "sortScripts": true },
  "ignorePatterns": ["bun.lock"]
}
