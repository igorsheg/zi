{
  "name": "zi-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-agent-core": "0.83.0",
      "@earendil-works/pi-ai": "0.83.0",
      "@opentui/core": "0.4.5",
      "@types/bun": "1.3.14",
      "entities": "7.0.1",
      "nanostores": "1.4.0",
      "string-width": "7.2.0",
      "typebox": "1.3.7",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-local.ts",
    "build:website": "bun scripts/build-website.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun --hot packages/cli/src/main.ts",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "install:local": "bun scripts/install-local-zi.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "package:npm": "bun scripts/build-npm-packages.ts",
    "prepare": "lefthook install",
    "release:build": "bun scripts/build-release.ts",
    "start": "bun packages/cli/src/main.ts",
    "test": "bun test scripts && bun run --sequential --filter '*' test",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
