{
  "name": "openzi-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-agent-core": "0.80.6",
      "@earendil-works/pi-ai": "0.80.6",
      "@opentui/core": "0.4.3",
      "@types/bun": "1.3.14",
      "nanostores": "1.4.0",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun --hot packages/cli/src/main.ts",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "start": "bun packages/cli/src/main.ts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
