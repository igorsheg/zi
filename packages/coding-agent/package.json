{
  "name": "@with-zi/coding-agent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal/extension-worker": "./src/extensions/worker-entry.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test --max-concurrency=1 --preload ../../test/isolate-zi-home.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@with-zi/extension-api": "workspace:*",
    "diff": "9.0.0",
    "ignore": "7.0.5",
    "proper-lockfile": "4.1.2",
    "typebox": "catalog:",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "catalog:"
  }
}
